# Copy to secrets.toml (keep it out of version control), or set these as
# environment variables.
ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional — voice input on Feature engineering (OpenAI speech-to-text). The
# app runs without it; the microphone is simply not shown.
OPENAI_API_KEY = "sk-your-openai-key-here"

# Optional — Snowflake, for loading data from a table or query and writing
# predictions back. Every field is optional and pre-fills the connection form,
# so a deployment can set the account and warehouse here and still have each
# user sign in as themselves.
[snowflake]
account = "xy12345.us-east-1"
user = "SVC_ML"
# password = "..."                  # or key-pair / browser SSO on the form
role = "ML_ANALYST"
warehouse = "WH_XS"
database = "ANALYTICS"
schema = "ML"
# private_key_path = "/path/to/rsa_key.p8"
